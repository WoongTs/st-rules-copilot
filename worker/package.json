{
  "name": "@smartthings-rules-copilot/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local --port 8787",
    "build": "wrangler deploy --dry-run --env=\"\" --outdir dist",
    "deploy:production": "wrangler deploy --env=\"\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "instructions:gpt": "node --experimental-strip-types scripts/print-gpt-instructions.ts",
    "cf-types": "wrangler types src/worker-configuration.d.ts --config wrangler.example.jsonc"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^0.8.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "agents": "^0.16.2",
    "hono": "^4.13.5",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.18.4",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.110.0"
  }
}
